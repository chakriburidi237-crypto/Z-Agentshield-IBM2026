# ==============================================================================
# Z-AgentShield Configuration Example
# Non-secret placeholders for local and containerized development.
# Do not store real API keys, passwords, or production secrets in this file.
# ==============================================================================

# Application Environment
APP_ENV=demo
APP_NAME=Z-AgentShield
LOG_LEVEL=INFO
DEBUG=false

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Persistence Settings (SQLite)
DATABASE_PATH=data/zagentshield.db

# Policy Configuration
POLICY_CONFIG_PATH=config/policies.yaml

# Risk Scoring Thresholds (0 - 100 scale)
# Actions with risk < RISK_THRESHOLD_REVIEW -> ALLOW
# Actions with risk >= RISK_THRESHOLD_REVIEW and < RISK_THRESHOLD_BLOCK -> REVIEW
# Actions with risk >= RISK_THRESHOLD_BLOCK -> BLOCK
RISK_THRESHOLD_REVIEW=40.0
RISK_THRESHOLD_BLOCK=75.0

# Anomaly Detection Settings
ANOMALY_WINDOW_SECONDS=60
ANOMALY_BURST_THRESHOLD=10
ISOLATION_FOREST_CONTAMINATION=0.05

# Redaction Settings
REDACT_SECRETS=true
REDACT_PII=true

# Streamlit Dashboard Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
